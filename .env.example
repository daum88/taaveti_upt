# One shared provider/model is used by the seven single-model strategy agents.
# The AI Investment Committee has a separate GitHub Copilot roster below.
# Active provider: deepseek | groq | ollama
LLM_PROVIDER=deepseek

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ollama (local, free) — brew install ollama && ollama pull llama3.2
# Then set: LLM_PROVIDER=ollama

# Leave AGENT_MODEL_ROSTER unset to preserve the seven-agent single-model subgroup.
# Per-agent bindings remain available as a technical override.
# AGENT_MODEL_ROSTER={"trend":{"provider":"groq","model":"llama-3.3-70b-versatile"}}

# Multi-model AI Investment Committee. Authenticate once with `pi`, then `/login`
# and select GitHub Copilot. The simulator reads pi's OAuth session without copying it.
# PI_CLI_PATH=pi
# PI_COPILOT_ADVISER_MODELS=claude-opus-4.8,gpt-5.6-terra,kimi-k3
# PI_COPILOT_JUDGE_MODEL=gpt-5.6-sol
# PI_COPILOT_THINKING=medium
# PI_COPILOT_TIMEOUT_SECONDS=90
# PI_COPILOT_MAX_RESPONSE_CHARS=20000
# PI_COPILOT_RETRY_ATTEMPTS=2
# PI_COPILOT_RETRY_BACKOFF_SECONDS=30

# Server: binds only to this computer by default.
# A non-loopback SERVER_HOST requires a 32+ character bearer token for operator actions.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Send it as: Authorization: Bearer <OPERATOR_TOKEN>
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080
# OPERATOR_TOKEN=
# Explicitly disables non-loopback operator authentication. Development-only; never use on a shared network.
# ALLOW_INSECURE_NONLOOPBACK=false

# Optional overrides
# STARTING_BALANCE=10000.00
# FUNNEL_INTERVAL_HOURS=3
# Decision batches reuse the latest completed market refresh younger than this (0 = always refresh).
# FUNNEL_REUSE_MAX_AGE_MINUTES=30
# Manual-decision reminder only; it never starts an LLM batch automatically.
# Tuesday and Thursday at 10:00 America/New_York by default (0=Mon ... 6=Sun).
# DECISION_REMINDER_TIMEZONE=America/New_York
# DECISION_REMINDER_WEEKDAYS=1,3
# DECISION_REMINDER_TIME=10:00
# Timeout for each blocking LLM provider request.
# LLM_REQUEST_TIMEOUT_SECONDS=30
# Cap on generated tokens per agent decision; reasoning models count hidden thinking against it.
# AGENT_MAX_OUTPUT_TOKENS=4096
# Maximum age of a yfinance quote used for a simulated fill.
# EXECUTION_QUOTE_MAX_AGE_SECONDS=30
# Seconds between live dashboard quote broadcasts. The default is 30 seconds.
# DASHBOARD_REFRESH_SECONDS=30
# Select the shared model for the active provider before initializing the database.
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=llama3.2
# Keep this many leaderboard chart snapshots per user (written after trades/cycles).
# LEADERBOARD_SNAPSHOT_RETENTION_PER_USER=720
