# Active provider (deepseek | groq | ollama)
LLM_PROVIDER=deepseek

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ollama (local, free) — brew install ollama && ollama pull llama3.2
# Then set: LLM_PROVIDER=ollama

# Server: binds only to this computer by default. Set SERVER_HOST=0.0.0.0 only for LAN testing.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080

# Optional overrides
# STARTING_BALANCE=10000.00
# FUNNEL_INTERVAL_HOURS=3
# Keep this many leaderboard chart snapshots per user (written after trades/cycles).
# LEADERBOARD_SNAPSHOT_RETENTION_PER_USER=720
